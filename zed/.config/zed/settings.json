// Zed settings
{
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Nordfox - blurred"
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "languages": {
    "Elixir": {
      "inlay_hints": {
        "enabled": true,
      },
      "tab_size": 2,
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "format_on_save": "on",
  "preferred_line_length": 100,
  "soft_wrap": "editor_width",
  "diff_view_style": "split",
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": false,
    "indent_size": 24.0,
    "hide_gitignore": false,
    "entry_spacing": "standard",
    "diagnostic_badges": true,
  },
  "git_panel": {
    "tree_view": true,
  },
  "collaboration_panel": {
    "button": false,
  },
  "title_bar": {
    "show_user_picture": false,
  },
  "file_finder": {
    "include_ignored": "smart",
  },
  "fast_scroll_sensitivity": 4.0,
  "scroll_sensitivity": 1.0,
  "horizontal_scroll_margin": 5.0,
  "vertical_scroll_margin": 3.0,
  "minimum_split_diff_width": 100.0,
  "outline_panel": {
    "expand_outlines_with_depth": 100,
  },
  "excerpt_context_lines": 2,
  "expand_excerpt_lines": 5,
  "which_key": {
    "delay_ms": 1000,
    "enabled": true,
  },
  "hide_mouse": "on_typing_and_action",
  "cursor_blink": false,
  "buffer_line_height": "standard",
  "terminal": {
    "font_size": 12.0,
    "keep_selection_on_copy": false,
    "copy_on_select": true,
  },
  "git": {
    "blame": {
      "show_avatar": false,
    },
    "inline_blame": {
      "enabled": true,
    },
  },
  "preview_tabs": {
    "enabled": false,
  },
  "tab_bar": {
    "show": false,
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrains Mono",
  "file_types": {
    "tailwindcss": ["*.css"],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": false,
  },
  "base_keymap": "Cursor",
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "auto_install_extensions": {
    "astro": true,
    "catppuccin": true,
    "color-highlight": true,
    "dart": true,
    "docker-compose": true,
    "dockerfile": true,
    "elixir": true,
    "git-firefly": true,
    "html": true,
    "macos-classic": true,
    "make": true,
    "nvim-nightfox": true,
    "oxc": true,
    "rainbow-csv": true,
    "sql": true,
    "terraform": true,
    "toml": true,
  },
}
